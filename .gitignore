# 依赖与构建产物
node_modules/
server/dist/
web/dist/

# 本地环境变量：真实密钥只放在这里，永远不进仓库
.env
.env.local
.env.*.local

# 运行时上传入库的语料（演示数据；如需随仓库分发可移除这一行）
data/uploads/*.md

# 日志与临时文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# 编辑器与 AI 工具
.vscode/*
!.vscode/extensions.json
.idea/
.trae/
.cursor/
.claude/

# 测试覆盖率
coverage/

# 内部材料：保留在工作区，不随仓库分发
docs/demo-script-extra-mobile-theme.md
docs/teammate-first-commit-guide.md
