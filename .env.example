# ============================================
# CampusPilot 环境变量示例
# 使用方法：复制本文件为仓库根目录的 .env
#   PowerShell: Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，绝对不要把真实 Key 提交进仓库
# ============================================

# 大模型 API Key。留空 => 自动降级为 mock 演示模式（不发起任何外部请求）
# 该变量只在后端进程中读取，前端通过 /api 代理访问，拿不到 Key
LLM_API_KEY=

# OpenAI 兼容接口地址（可换成任何兼容 /chat/completions 的服务）
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000

# 后端端口
PORT=8787

# ---------- 安全与成本控制 ----------
# 单 IP 每分钟最多请求数
RATE_LIMIT_PER_MINUTE=20
# 单 IP 每日请求上限
DAILY_REQUEST_LIMIT=60
# 单 IP 每日 token 消耗上限（按字符数估算，用于成本护栏）
DAILY_TOKEN_LIMIT=120000

# 单次输入最大字符数，超出直接拦下
INPUT_MAX_CHARS=500

# 相同问题的答案缓存：有效期与最大条数
CACHE_TTL_MS=600000
CACHE_MAX_ENTRIES=200
